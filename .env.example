PORT=3000

# --- Exporter mode (install on every monitored server) ---
# Enables GET /mon/proc, /mon/mem, /mon/dfree. Clients must send "Authorization: Bearer <EXPORTER_KEY>".
ENABLE_EXPORTER=true
EXPORTER_KEY=change-me-exporter-key
# Mount point reported by /mon/dfree
DISK_PATH=/

# --- Monitor + dashboard mode (install on the central server) ---
# Enables the scheduler and dashboard. When false, GET / just returns {"status":"ok"}.
ENABLE_MONITOR=true
# Passphrase for the dashboard login (required when ENABLE_MONITOR=true)
DASHBOARD_PASSPHRASE=change-me-passphrase
CONFIG_PATH=config.json
DB_PATH=bluemores.db
CHECK_TIMEOUT=10s
RETENTION_DAYS=30
# Run every check once at startup (otherwise daily checks show "pending" until their first schedule)
RUN_ON_START=true
# Set true when served over HTTPS
COOKIE_SECURE=false
LOG_REQUESTS=false
